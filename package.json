{
  "name": "dsh-session-relocate",
  "version": "0.1.1",
  "description": "在 DSH 里安全迁移会话：预演、健康预检、跨盘降级、批量迁移、迁移历史与一键撤销、孤儿会话归位、智能分组建议。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "workspace",
    "session",
    "session-migration",
    "session-relocation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zyfsyx666/dsh-session-relocate.git"
  },
  "bugs": {
    "url": "https://github.com/zyfsyx666/dsh-session-relocate/issues"
  },
  "homepage": "https://github.com/zyfsyx666/dsh-session-relocate#readme",
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-workspace": "*",
    "@deepseek-ai/dsh-session-persistence": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-workspace": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-persistence": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.2": "compatible"
      }
    }
  }
}
